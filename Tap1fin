local BONES_R15 = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
}
local BONES_R6 = { {"Head","Torso"}, {"Torso","Left Arm"}, {"Torso","Right Arm"}, {"Torso","Left Leg"}, {"Torso","Right Leg"} }

local function newDraw(kind, props)
    local d = Drawing.new(kind)
    for k, v in pairs(props or {}) do d[k] = v end
    d.Visible = false
    return d
end

local function espData(char)
    local d = E.data[char]
    if d then return d end
    d = { phase = math.random() * math.pi * 2, bones = {} }
    if hasDrawing then
        for i = 1, #BONES_R15 do d.bones[i] = newDraw("Line", { Thickness = 1.5 }) end
        d.boxOutline = newDraw("Square", { Thickness = 3, Filled = false, Color = Color3.new(0, 0, 0) })
        d.boxFill = newDraw("Square", { Filled = true, Transparency = 0.2 })
        d.box = newDraw("Square", { Thickness = 1.5, Filled = false })
        d.name = newDraw("Text", { Center = true, Outline = true, Size = 14 })
        d.dist = newDraw("Text", { Center = true, Outline = true, Size = 13 })
        d.hpBack = newDraw("Square", { Filled = true, Color = Color3.new(0, 0, 0) })
        d.hpFill = newDraw("Square", { Filled = true })
    end
    E.data[char] = d
    return d
end

local function hideDraw(d)
    for _, l in ipairs(d.bones) do l.Visible = false end
    for _, k in ipairs({ "boxOutline", "boxFill", "box", "name", "dist", "hpBack", "hpFill" }) do
        if d[k] then d[k].Visible = false end
    end
end
local function hideAll(d)
    if hasDrawing then hideDraw(d) end
    if d.hl then d.hl.Enabled = false end
    if d.ring then d.ring.Visible = false end
end
local function removeEsp(char)
    local d = E.data[char]
    if not d then return end
    E.data[char] = nil
    for _, l in ipairs(d.bones) do pcall(function() l:Remove() end) end
    for _, k in ipairs({ "boxOutline", "boxFill", "box", "name", "dist", "hpBack", "hpFill" }) do
        if d[k] then pcall(function() d[k]:Remove() end) end
    end
    if d.hl then d.hl:Destroy() end
    if d.ring then d.ring:Destroy() end
end

local function toScreen(c, pos)
    local v, on = c:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), on and v.Z > 0
end

local cachedUnits, unitsAt = {}, 0

local function drawESP(t)
    local c = workspace.CurrentCamera
    if not c then return end
    local anyOn = E.highlight or E.skeleton or E.box or E.ring or E.names or E.distance or E.health
    if os.clock() - unitsAt > 0.2 then cachedUnits = unitList() unitsAt = os.clock() end
    local seen = {}
    local rb = E.rainbow and rainbow(0.15)
    local camPos = c.CFrame.Position

    for _, u in ipairs(cachedUnits) do
        local char = u.char
        local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Head")
        local show = anyOn and root and isAlive(u) and (u.player or E.bots) and not (E.teamCheck and sameTeam(u))
        local dist = root and (root.Position - camPos).Magnitude or math.huge
        if show and dist > E.maxDist then show = false end
        if not show then
            if E.data[char] then hideAll(E.data[char]) end
            continue
        end
        seen[char] = true
        local d = espData(char)
        local function col(k) return rb or E.colors[k] end

        if E.highlight then
            if not d.hl then
                d.hl = Instance.new("Highlight")
                d.hl.OutlineTransparency = 0
                d.hl.Parent = espFolder
            end
            if d.hl.Adornee ~= char then d.hl.Adornee = char end
            d.hl.FillColor, d.hl.OutlineColor = col("highlight"), col("highlight")
            d.hl.FillTransparency = E.hlFill
            d.hl.DepthMode = E.throughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
            d.hl.Enabled = true
        elseif d.hl then
            d.hl.Enabled = false
        end

        if E.ring then
            if not d.ring then
                local r = Instance.new("CylinderHandleAdornment")
                r.Radius, r.InnerRadius, r.Height = 2.6, 2.42, 0.12
                r.ZIndex, r.Transparency = 1, 0.1
                r.Parent = espFolder
                d.ring = r
            end
            if d.ring.Adornee ~= root then d.ring.Adornee = root end
            d.ring.AlwaysOnTop = E.throughWalls
            d.ring.CFrame = CFrame.new(0, math.sin(t * 2.2 + d.phase) * 2.5 - 0.3, 0) * CFrame.Angles(math.rad(90), 0, 0)
            d.ring.Color3 = col("ring")
            d.ring.Visible = true
        elseif d.ring then
            d.ring.Visible = false
        end

        if not hasDrawing then continue end

        local okBox, cf, size = pcall(char.GetBoundingBox, char)
        local minV, maxV, onAny
        if okBox then
            local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
            minV, maxV = Vector2.new(math.huge, math.huge), Vector2.new(-math.huge, -math.huge)
            for _, sx in ipairs({ -1, 1 }) do for _, sy in ipairs({ -1, 1 }) do for _, sz in ipairs({ -1, 1 }) do
                local p, on = toScreen(c, (cf * CFrame.new(hx * sx, hy * sy, hz * sz)).Position)
                if on then
                    onAny = true
                    minV = Vector2.new(math.min(minV.X, p.X), math.min(minV.Y, p.Y))
                    maxV = Vector2.new(math.max(maxV.X, p.X), math.max(maxV.Y, p.Y))
                end
            end end end
        end
        if not onAny then hideDraw(d) continue end
        local w, h = maxV.X - minV.X, maxV.Y - minV.Y

        if E.box then
            d.boxOutline.Position, d.boxOutline.Size = minV, Vector2.new(w, h)
            d.boxOutline.Thickness = E.boxThickness + 2
            d.boxOutline.Visible = true
            d.box.Position, d.box.Size = minV, Vector2.new(w, h)
            d.box.Thickness, d.box.Color, d.box.Visible = E.boxThickness, col("box"), true
            d.boxFill.Position, d.boxFill.Size, d.boxFill.Color = minV, Vector2.new(w, h), col("box")
            d.boxFill.Transparency = 0.15
            d.boxFill.Visible = E.boxFilled
        else
            d.box.Visible, d.boxOutline.Visible, d.boxFill.Visible = false, false, false
        end

        if E.skeleton then
            local list = char:FindFirstChild("UpperTorso") and BONES_R15 or BONES_R6
            for i, line in ipairs(d.bones) do
                local pair = list[i]
                local a = pair and char:FindFirstChild(pair[1])
                local b = pair and char:FindFirstChild(pair[2])
                if a and b then
                    local pa, va = toScreen(c, a.Position)
                    local pb, vb = toScreen(c, b.Position)
                    line.From, line.To = pa, pb
                    line.Color, line.Thickness = col("skeleton"), E.skelThickness
                    line.Visible = va and vb
                else
                    line.Visible = false
                end
            end
        else
            for _, l in ipairs(d.bones) do l.Visible = false end
        end

        if E.names then
            d.name.Text = u.name .. (u.player and "" or " [BOT]")
            d.name.Size, d.name.Color = E.textSize, col("names")
            d.name.Position = Vector2.new(minV.X + w / 2, minV.Y - E.textSize - 3)
            d.name.Visible = true
        else
            d.name.Visible = false
        end

        if E.distance then
            d.dist.Text = math.floor(dist + 0.5) .. " studs"
            d.dist.Size, d.dist.Color = math.max(E.textSize - 1, 8), col("distance")
            d.dist.Position = Vector2.new(minV.X + w / 2, maxV.Y + 3)
            d.dist.Visible = true
        else
            d.dist.Visible = false
        end

        if E.health then
            local hp, max = healthOf(u)
            local ratio = math.clamp(hp / max, 0, 1)
            local x = minV.X - 6
            d.hpBack.Position, d.hpBack.Size, d.hpBack.Visible = Vector2.new(x - 1, minV.Y - 1), Vector2.new(4, h + 2), true
            d.hpFill.Position = Vector2.new(x, minV.Y + h * (1 - ratio))
            d.hpFill.Size = Vector2.new(2, h * ratio)
            d.hpFill.Color = Color3.fromRGB(240, 90, 102):Lerp(Color3.fromRGB(82, 197, 148), ratio)
            d.hpFill.Visible = true
        else
            d.hpBack.Visible, d.hpFill.Visible = false, false
        end
    end

    for char, d in pairs(E.data) do
        if not char.Parent then removeEsp(char)
        elseif not seen[char] then hideAll(d) end
    end
end

