local function unitList()
    local list, seen = {}, {}
    local function add(char)
        if typeof(char) == "Instance" and char:IsA("Model") and not seen[char]
            and char ~= localPlayer.Character and char:IsDescendantOf(workspace) then
            seen[char] = true
            local owner = Players:GetPlayerFromCharacter(char)
            if owner and char:GetAttribute("deployed") == false then return end
            list[#list + 1] = { char = char, player = owner, name = owner and owner.DisplayName or char.Name }
        end
    end
    for _, char in CollectionService:GetTagged("Character") do add(char) end
    for _, p in Players:GetPlayers() do
        if p ~= localPlayer and p.Character then add(p.Character) end
    end
    return list
end

local function healthOf(u)
    local hum = u.char:FindFirstChildOfClass("Humanoid")
    return hum and math.max(hum.Health, 0) or 0, hum and math.max(hum.MaxHealth, 1) or 100
end

local function isAlive(u)
    local hum = u.char:FindFirstChildOfClass("Humanoid")
    return u.char.Parent ~= nil and hum ~= nil and hum.Health > 0
end

local function sameTeam(u)
    local owner = u.player
    return owner ~= nil and localPlayer.Team ~= nil and owner.Team == localPlayer.Team
        and not localPlayer.Neutral and not owner.Neutral
end

