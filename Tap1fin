local Opt = {
    silent = false, useFov = false, fov = 180,
    noRecoil = false, noReload = false,
    rapidFire = false, fireRate = 1000,
}
local active = true

local function screenCenter()
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    return Vector2.new(vp.X / 2, vp.Y / 2)
end

local function insideFov(part)
    if not Opt.useFov then return true end
    local cam = workspace.CurrentCamera
    if not cam then return true end
    local sp, onScreen = cam:WorldToViewportPoint(part.Position)
    if not onScreen then return false end
    return (Vector2.new(sp.X, sp.Y) - screenCenter()).Magnitude <= Opt.fov
end

--==================================================--
--// SILENT AIM
--==================================================--
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

local offsets = {
    Vector3.new(0.36, 0, 0),
    Vector3.new(-0.36, 0, 0),
    Vector3.new(0, 0.36, 0),
    Vector3.new(0, -0.36, 0),
}

local function chooseHit(origin, direction)
    local exclusions = {}
    if localPlayer.Character then exclusions[#exclusions + 1] = localPlayer.Character end
    local effects = workspace:FindFirstChild("Effects")
    if effects then exclusions[#exclusions + 1] = effects end
    params.FilterDescendantsInstances = exclusions

    local candidates = {}
    local visited = {}

    local function consider(character)
        if not character or not character:IsA("Model") or visited[character]
            or character == localPlayer.Character or not character:IsDescendantOf(workspace) then
            return
        end
        visited[character] = true

        local owner = Players:GetPlayerFromCharacter(character)
        if owner and localPlayer.Team ~= nil and owner.Team == localPlayer.Team
            and not localPlayer.Neutral and not owner.Neutral then
            return
        end
        if owner and character:GetAttribute("deployed") == false then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 or character:FindFirstChild("ForceField") then return end

        local head = character:FindFirstChild("Hitbox_Head") or character:FindFirstChild("Head")
        local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local aimPart = head or torso or rootPart
        if not aimPart or not aimPart:IsA("BasePart") then return end
        if not insideFov(aimPart) then return end

        local towards = aimPart.Position - origin
        local distance = towards.Magnitude
        if distance <= 0 or distance > maxDistance then return end

        local parts = {}
        local used = {}
        local function include(part)
            if part and part:IsA("BasePart") and not used[part] then
                used[part] = true
                parts[#parts + 1] = part
            end
        end
        include(head)
        include(torso)
        include(rootPart)
        include(character:FindFirstChild("LowerTorso"))
        include(character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm"))
        include(character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm"))

        local exposedParts = {}
        if head and head:IsA("BasePart") then exposedParts[#exposedParts + 1] = head end
        if torso and torso:IsA("BasePart") and torso ~= head then exposedParts[#exposedParts + 1] = torso end

        candidates[#candidates + 1] = {
            character = character,
            parts = parts,
            exposedParts = exposedParts,
            distance = distance,
            alignment = towards.Unit:Dot(direction),
        }
    end

    for _, character in CollectionService:GetTagged("Character") do consider(character) end
    for _, player in Players:GetPlayers() do
        if player ~= localPlayer and player.Character then consider(player.Character) end
    end

    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if a.alignment == b.alignment then return a.distance < b.distance end
        return a.alignment > b.alignment
    end)

    local function checkPoint(candidate, point)
        local towards = point - origin
        local distance = towards.Magnitude
        if distance <= 0 or distance > maxDistance then return end
        local hit = workspace:Raycast(origin, towards, params)
        if not hit or not hit.Instance:IsDescendantOf(candidate.character) then return end

        local impactPart = hit.Instance
        local parent = impactPart.Parent
        if parent and (parent:IsA("Hat") or parent:IsA("Accessory")
            and (parent.AccessoryType == Enum.AccessoryType.Hat
                or parent.AccessoryType == Enum.AccessoryType.Face)) then
            impactPart = candidate.character:FindFirstChild("Hitbox_Head")
                or candidate.character:FindFirstChild("Head") or impactPart
        end
        return candidate.character, impactPart, hit.Position, towards.Unit
    end

    for _, candidate in candidates do
        for _, part in candidate.parts do
            local character, hitPart, position, towards = checkPoint(candidate, part.Position)
            if character then return character, hitPart, position, towards end
        end
        for _, part in candidate.exposedParts do
            for _, offset in offsets do
                local point = part.CFrame:PointToWorldSpace(Vector3.new(
                    part.Size.X * offset.X, part.Size.Y * offset.Y, 0))
                local character, hitPart, position, towards = checkPoint(candidate, point)
                if character then return character, hitPart, position, towards end
            end
        end
    end
    return nil
end

