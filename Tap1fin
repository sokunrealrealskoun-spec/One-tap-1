local E = {
    highlight = false, skeleton = false, box = false, ring = false, names = false, distance = false, health = false,
    teamCheck = false, bots = true, throughWalls = true, maxDist = 1500, rainbow = false,
    boxFilled = false, boxThickness = 1.5, skelThickness = 1.5, textSize = 14, hlFill = 0.6,
    colors = { highlight = WHITE, skeleton = WHITE, box = WHITE, ring = WHITE, names = WHITE, distance = Color3.fromRGB(190, 190, 190) },
