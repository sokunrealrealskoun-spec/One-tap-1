end)

local ZRState
local function stop()
    if not active then return end
    active = false
    if shotPacket.send == newSend then shotPacket.send = originalSend end
    if weaponClient.getBullets == newGetBullets then weaponClient.getBullets = originalGetBullets end
    if weaponClient.decreaseBullets == newDecreaseBullets then weaponClient.decreaseBullets = originalDecreaseBullets end
    if viewmodelClient and viewmodelClient.shoot == newShoot then viewmodelClient.shoot = originalViewmodelShoot end
    if weaponSpring and weaponSpring.shove == suppressKick then weaponSpring.shove = originalWeaponKick end
    for weaponData, saved in pairs(savedFireRates) do weaponData.firerate = saved.value end
    table.clear(savedFireRates)
    pcall(function() renderConn:Disconnect() end)
    for p in pairs(vmSaved) do vmRestore(p) end
    for char in pairs(E.data) do removeEsp(char) end
    pcall(function() espFolder:Destroy() end)
    if Circle then pcall(function() Circle:Remove() end) end
    for i = 1, 4 do if chLines[i] then pcall(function() chLines[i]:Remove() chOutlines[i]:Remove() end) end end
    if chDot then pcall(function() chDot:Remove() chDotOutline:Remove() end) end
    if rawget(environment, "ZROneTap") == ZRState then rawset(environment, "ZROneTap", nil) end
end
ZRState = { stop = function() stop() pcall(function() Library:Unload() end) end }
rawset(environment, "ZROneTap", ZRState)

