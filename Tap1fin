local VM = {
    gun = { on = false, color = Color3.fromRGB(160, 120, 255), mat = "ForceField", trans = 0, rainbow = false, noTex = true },
    arms = { on = false, color = Color3.fromRGB(255, 255, 255), mat = "ForceField", trans = 0, rainbow = false, noTex = true },
}
local VM_MATERIALS = { "Original", "ForceField", "Neon", "Glass", "SmoothPlastic", "Plastic", "Metal", "Foil" }
local vmSaved = {}

local function vmGroup(part)
    local n = part.Name:lower()
    if n == "humanoidrootpart" or n == "camerabone" then return nil end
    if n:find("arm", 1, true) or n:find("hand", 1, true) or n:find("glove", 1, true) or n:find("sleeve", 1, true) then
        return "arms"
    end
    return "gun"
end

local function vmSave(p)
    if vmSaved[p] then return vmSaved[p] end
    local s = { Color = p.Color, Material = p.Material, Transparency = p.Transparency, hidden = {} }
    if p:IsA("MeshPart") then s.TextureID = p.TextureID end
    if p:IsA("UnionOperation") then s.UsePartColor = p.UsePartColor end
    vmSaved[p] = s
    return s
end

local function vmRestore(p)
    local s = vmSaved[p]
    if not s then return end
    vmSaved[p] = nil
    pcall(function()
        p.Color, p.Material, p.Transparency = s.Color, s.Material, s.Transparency
        if s.TextureID ~= nil then p.TextureID = s.TextureID end
        if s.UsePartColor ~= nil then p.UsePartColor = s.UsePartColor end
        for obj, info in pairs(s.hidden) do
            if info.parent then obj.Parent = info.parent else obj.Transparency = info.trans end
        end
    end)
end

local function applyViewmodel()
    local cam = workspace.CurrentCamera
    local vm = cam and cam:FindFirstChild("Viewmodel")
    if vm then
        for _, p in ipairs(vm:GetDescendants()) do
            if p:IsA("BasePart") then
                local g = vmGroup(p)
                local cfg = g and VM[g]
                if cfg and cfg.on then
                    local s = vmSave(p)
                    if s.Transparency < 1 then
                        pcall(function()
                            p.Color = cfg.rainbow and rainbow(0.25) or cfg.color
                            p.Material = cfg.mat == "Original" and s.Material or Enum.Material[cfg.mat]
                            p.Transparency = math.max(cfg.trans, s.Transparency)
                            if p:IsA("UnionOperation") then p.UsePartColor = true end
                            if p:IsA("MeshPart") then p.TextureID = cfg.noTex and "" or s.TextureID end
                            if cfg.noTex then
                                for _, c in ipairs(p:GetChildren()) do
                                    if c:IsA("SurfaceAppearance") and not s.hidden[c] then
                                        s.hidden[c] = { parent = p }
                                        c.Parent = nil
                                    elseif (c:IsA("Decal") or c:IsA("Texture")) and not s.hidden[c] then
                                        s.hidden[c] = { trans = c.Transparency }
                                        c.Transparency = 1
                                    end
                                end
                            end
                        end)
                    end
                elseif vmSaved[p] then
                    vmRestore(p)
                end
            end
        end
    end
    for p in pairs(vmSaved) do
        if not p.Parent then vmSaved[p] = nil end
    end
end

local function vmBox(box, key, title)
    local cfg = VM[key]
    local id = "VM_" .. key
    box:AddToggle(id, { Text = "Color " .. title, Default = false, Callback = function(v) cfg.on = v end })
    Toggles[id]:AddColorPicker(id .. "Color", { Default = cfg.color, Title = title .. " Color", Callback = function(c) cfg.color = c end })
    box:AddDropdown(id .. "Mat", { Text = "Material", Values = VM_MATERIALS, Default = cfg.mat, Callback = function(v)
        cfg.mat = v
        for p in pairs(vmSaved) do if vmGroup(p) == key then vmRestore(p) end end
    end })
    box:AddSlider(id .. "Trans", { Text = "Transparency", Default = 0, Min = 0, Max = 0.95, Rounding = 2, Callback = function(v) cfg.trans = v end })
    box:AddToggle(id .. "NoTex", { Text = "Remove Textures", Default = true, Callback = function(v)
        cfg.noTex = v
        for p in pairs(vmSaved) do if vmGroup(p) == key then vmRestore(p) end end
    end })
    box:AddToggle(id .. "Rainbow", { Text = "Rainbow", Default = false, Callback = function(v) cfg.rainbow = v end })
end
