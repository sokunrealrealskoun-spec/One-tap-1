local function findWeaponSpring()
    if type(originalViewmodelShoot) ~= "function" then return nil end
    local weaponSpring
    for _, value in pairs(readUpvalues(originalViewmodelShoot)) do
        if type(value) == "table"
            and rawget(value, "Mass") == 5
            and rawget(value, "Force") == 100
            and rawget(value, "Damping") == 15
            and rawget(value, "Speed") == 3
            and type(rawget(value, "shove")) == "function" then
            if weaponSpring then return nil end
            weaponSpring = value
        end
    end
    return weaponSpring
end
local weaponSpring = findWeaponSpring()
local originalWeaponKick = weaponSpring and weaponSpring.shove

local function findShotPacket()
    local fireShot
    for _, value in pairs(readUpvalues(weaponClient.fire)) do
        if type(value) == "function" then
            if fireShot then return nil end
            fireShot = value
        end
    end
    if not fireShot then return nil end
    local packet
    for _, value in pairs(readUpvalues(fireShot)) do
        if type(value) == "table"
            and type(rawget(value, "send")) == "function"
            and type(rawget(value, "reader")) == "function"
            and type(rawget(value, "listen")) == "function" then
            if packet then return nil end
            packet = value
        end
    end
    return packet
end

local shotPacket
