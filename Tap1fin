local renderConn = RunService.RenderStepped:Connect(function(dt)
    if not active then return end
    local center = screenCenter()
    pcall(drawESP, os.clock())
    pcall(applyViewmodel)
    if Circle then
        Circle.Position = center
        Circle.Radius = Opt.fov
        Circle.Thickness = FC.thickness
        Circle.Transparency = FC.transparency
        Circle.Filled = FC.filled
        Circle.NumSides = FC.sides
        Circle.Color = FC.rainbow and rainbow(0.25) or FC.color
        Circle.Visible = Opt.silent and Opt.useFov and FC.show
    end
    if hasDrawing then
        if CH.enabled then
            if CH.spin then CH.angle = (CH.angle + math.rad(CH.spinSpeed) * dt) % (math.pi * 2) else CH.angle = 0 end
            local color = CH.rainbow and rainbow(0.3) or CH.color
            for i = 1, 4 do
                local a = CH.angle + (i - 1) * math.pi / 2
                local dir = Vector2.new(math.cos(a), math.sin(a))
                local from, to = center + dir * CH.gap, center + dir * (CH.gap + CH.length)
                local o = chOutlines[i]
                o.From, o.To, o.Thickness, o.Visible = from - dir, to + dir, CH.thickness + 2, CH.outline
                local l = chLines[i]
                l.From, l.To, l.Thickness, l.Color, l.Visible = from, to, CH.thickness, color, true
            end
            chDotOutline.Position, chDotOutline.Radius, chDotOutline.Visible = center, CH.thickness + 1, CH.dot and CH.outline
            chDot.Position, chDot.Radius, chDot.Color, chDot.Visible = center, CH.thickness, color, CH.dot
        else
            for i = 1, 4 do chLines[i].Visible = false chOutlines[i].Visible = false end
            chDot.Visible, chDotOutline.Visible = false, false
        end
    end
end)
