local originalSend = shotPacket.send
local originalGetBullets = weaponClient.getBullets
local originalDecreaseBullets = weaponClient.decreaseBullets
local savedFireRates = {}

local function newSend(shot)
    if active and Opt.silent and type(shot) == "table" and shot.weaponType ~= "Knife"
        and typeof(shot.origin) == "Vector3" and typeof(shot.direction) == "Vector3" then
        local character, part, position, direction = chooseHit(shot.origin, shot.direction)
        if character then
            shot.hitResult = character
            shot.hitPart = part
            shot.position = position
            shot.direction = direction
        end
    end
    return originalSend(shot)
end

local function newGetBullets()
    if active and Opt.noReload then
        local character = localPlayer.Character
        if character then
            local slot = character:GetAttribute("currentWeapon")
            if slot == nil or slot == "Primary" or slot == "Secondary" then
                return weaponClient.getMaxBulletsForCurrentWeapon()
            end
        end
    end
    return originalGetBullets()
end

local function newDecreaseBullets()
    if active and Opt.noReload then
        local character = localPlayer.Character
        if character and character:GetAttribute("currentWeapon") == "Knife" then
            originalDecreaseBullets()
        end
        return
    end
    originalDecreaseBullets()
end

local function newShoot(isKnife)
    originalViewmodelShoot((active and Opt.noRecoil) or isKnife)
end

local function suppressKick(...)
    if not (active and Opt.noRecoil) then originalWeaponKick(...) end
end

shotPacket.send = newSend
weaponClient.getBullets = newGetBullets
weaponClient.decreaseBullets = newDecreaseBullets
local recoilAvailable = weaponSpring ~= nil
if recoilAvailable then
    weaponSpring.shove = suppressKick
    viewmodelClient.shoot = newShoot
end

local function applyFireRate()
    for _, weaponData in pairs(weaponManager.getWeapons()) do
        if type(weaponData) == "table" then
            if Opt.rapidFire then
                if not savedFireRates[weaponData] then
                    savedFireRates[weaponData] = { value = rawget(weaponData, "firerate") }
                end
                weaponData.firerate = Opt.fireRate
            elseif savedFireRates[weaponData] then
                weaponData.firerate = savedFireRates[weaponData].value
                savedFireRates[weaponData] = nil
            end
        end
    end
end

